# MongoDB Configuration
MONGODB_URI=mongodb://your-username:your-password@localhost:27017/task_management_db
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/task_management_db

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=change_this_to_a_strong_random_string_in_production
JWT_EXPIRE=7d
